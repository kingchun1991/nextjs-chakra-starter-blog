{
  "name": "nextjs-chakra-starter-blog",
  "version": "0.1.0",
  "private": true,
  "author": "agustinusnathaniel",
  "scripts": {
    "biome:check": "biome check --no-errors-on-unmatched",
    "biome:ci": "biome ci",
    "biome:fix": "pnpm biome:check --write",
    "build": "pnpm generate-json && next build",
    "postbuild": "pnpm validate-content && node scripts/build-directory-graph.mjs && next-sitemap --config next-sitemap.config.js",
    "build:turbo": "pnpm turbo run build",
    "build-graph": "node scripts/build-directory-graph.mjs",
    "check:turbo": "pnpm turbo ultracite:check type:check",
    "dev": "pnpm generate-json && next dev",
    "generate-json": "node scripts/json-generator.mjs",
    "prepare": "husky",
    "push-release": "git push --follow-tags origin main",
    "release": "cross-env HUSKY=0 commit-and-tag-version",
    "start": "next start",
    "test:e2e": "playwright test",
    "turbo": "pnpm dlx turbo@2.6.1",
    "type:check": "tsc --noEmit",
    "ultracite:check": "ultracite check",
    "ultracite:fix": "ultracite fix",
    "up-interactive": "pnpm up -i",
    "up-latest": "pnpm up-interactive -L",
    "validate-content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@mdx-js/loader": "3.1.0",
    "@next/mdx": "^16.4.6",
    "@vercel/og": "^0.11.1",
    "clsx": "^2.1.1",
    "commit-and-tag-version": "^12.7.3",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "knip": "^5.87.0",
    "marked": "^17.0.4",
    "mermaid": "^11.17.2",
    "next": "^16.4.6",
    "next-intl": "^4.15.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "reading-duration": "^1.1.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rss": "^1.2.2",
    "turbo": "2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@chakra-ui/cli": "^3.38.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "20.2.0",
    "@commitlint/cz-commitlint": "20.2.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "next-sitemap": "^4.2.3",
    "typescript": "^5.9.3",
    "ultracite": "8.3.1"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "neverBuiltDependencies": []
  }
}
